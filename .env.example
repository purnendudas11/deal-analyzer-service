# Configuration Template
# Copy values from setup script output here

AWS_REGION=us-east-1
API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
S3_BUCKET_NAME=deal-structure-bucket-1234567890

# Optional: For custom deployments
LAMBDA_ROLE_NAME=deal-analyzer-lambda-role
ANALYZE_LAMBDA_NAME=analyze-deal-with-bedrock
PRESIGNED_LAMBDA_NAME=generate-presigned-url
API_GATEWAY_NAME=deal-analyzer-api

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
MAX_TOKENS=2000

# S3 Configuration  
S3_PREFIX=deals/
S3_LIFECYCLE_DAYS=30

# Lambda Configuration
LAMBDA_TIMEOUT_ANALYZE=60
LAMBDA_TIMEOUT_PRESIGNED=30
LAMBDA_MEMORY_ANALYZE=256
LAMBDA_MEMORY_PRESIGNED=128
PRESIGNED_URL_EXPIRATION=3600  # 1 hour in seconds
